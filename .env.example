PORT=3000
DATA_DIR=./data

# Optional but strongly recommended on a public Railway deployment.
DASHBOARD_PASSWORD=

# Required for GitHub user/repository monitoring.
GITHUB_TOKEN=

# Optional shared token for Socket.IO subscribers at /events.
EVENT_STREAM_TOKEN=

# Public origin used for links to readable update details.
# Railway discovers this automatically from RAILWAY_PUBLIC_DOMAIN.
WEBPAGE_TRACKER_PUBLIC_URL=

# Optional emergency override; normally discovered automatically from Google Play.
PUMP_RUNTIME_VERSION=
