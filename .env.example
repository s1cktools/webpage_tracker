PORT=3000
DATA_DIR=./data

# Optional but strongly recommended on a public Railway deployment.
DASHBOARD_PASSWORD=

# Required for GitHub user/repository monitoring.
GITHUB_TOKEN=

# Optional shared token for Socket.IO subscribers at /events.
EVENT_STREAM_TOKEN=

# Optional; Ansem coin API polling defaults to every 1000ms (minimum 250ms).
ANSEM_POLL_INTERVAL_MS=1000
