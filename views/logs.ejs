<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <meta http-equiv="refresh" content="5">
    <title>Logs — PagePulse</title>
    <link rel="stylesheet" href="/logs.css">
  </head>
  <body>
    <header class="topbar">
      <a href="/">← dashboard</a>
      <span>auto-refresh 5s</span>
    </header>

    <main>
      <section class="heading">
        <div>
          <span class="kicker">RUNTIME</span>
          <h1><%= selectedSite
            ? (selectedSite.nickname || selectedSite.hostname)
            : selectedGithub
              ? (selectedGithub.nickname || selectedGithub.target_key)
              : "global" %>.log</h1>
        </div>
        <span><%= logs.length %> entries</span>
      </section>

      <nav>
        <a class="<%= selectedSite || selectedGithub ? '' : 'active' %>" href="/logs">global</a>
        <% sites.forEach((site) => { %>
          <a class="<%= selectedSite?.id === site.id ? 'active' : '' %>" href="/logs?site=<%= site.id %>"><%= site.nickname || site.hostname %></a>
        <% }) %>
        <% githubTargets.forEach((target) => { %>
          <a class="<%= selectedGithub?.id === target.id ? 'active' : '' %>" href="/logs?github=<%= target.id %>">gh:<%= target.nickname || target.target_key %></a>
        <% }) %>
      </nav>

      <section class="terminal">
        <header>
          <span>time</span>
          <span>level</span>
          <span>target</span>
          <span>message</span>
        </header>

        <% if (!logs.length) { %>
          <div class="empty">no log entries</div>
        <% } %>

        <% logs.forEach((log) => { %>
          <article>
            <time datetime="<%= log.created_at %>"><%= log.created_at %></time>
            <span class="level <%= log.level %>"><%= log.level %></span>
            <a href="<%= log.targetUrl %>"><%= log.targetName %></a>
            <p><%= log.message %></p>
          </article>
        <% }) %>
      </section>
    </main>
  </body>
</html>
