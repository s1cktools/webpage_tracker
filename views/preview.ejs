<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>Message preview — PagePulse</title>
    <link rel="stylesheet" href="/preview.css">
  </head>
  <body>
    <header>
      <a href="/">← dashboard</a>
      <span>discord / message preview</span>
    </header>

    <main>
      <div class="intro">
        <div>
          <span class="label">PROPOSED EMBEDS</span>
          <h1>notification states</h1>
        </div>
        <p>Static previews. Nothing here sends to Discord.</p>
      </div>

      <section>
        <div class="section-label">
          <span>01</span>
          <div>
            <h2>single page</h2>
            <p>One URL found in a scan.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:20 PM</time></div>
              <div class="embed">
                <div class="embed-author">openai.com</div>
                <div class="embed-title">New policy ideas for the Intelligence Age</div>
                <a class="embed-link" href="#">https://openai.com/index/new-policy-ideas-for-the-intelligence-age/</a>
                <footer>NEW PAGE · sitemap · 3821ms · Today at 6:18 PM</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>02</span>
          <div>
            <h2>batch</h2>
            <p>Several URLs from one domain.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:21 PM</time></div>
              <div class="embed">
                <div class="embed-author">openai.com</div>
                <div class="embed-title">Introducing GPT-6</div>
                <a class="embed-link" href="#">https://openai.com/index/introducing-gpt-6/</a>
                <footer>NEW PAGE · sitemap · 4196ms · Today at 6:19 PM</footer>
              </div>
              <div class="embed stacked">
                <div class="embed-author">openai.com</div>
                <div class="embed-title">GPT-6 System Card</div>
                <a class="embed-link" href="#">https://openai.com/index/gpt-6-system-card/</a>
                <footer>NEW PAGE · sitemap · 4196ms · Today at 6:19 PM</footer>
              </div>
              <div class="embed stacked">
                <div class="embed-author">openai.com</div>
                <div class="embed-title">GPT-6 Model Documentation</div>
                <a class="embed-link" href="#">https://openai.com/docs/models/gpt-6/</a>
                <footer>NEW PAGE · sitemap · 4196ms · Today at 6:19 PM</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>03</span>
          <div>
            <h2>large batch</h2>
            <p>The list is capped instead of flooding the channel.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:22 PM</time></div>
              <div class="message-content">+14 more new pages were discovered.</div>
              <div class="embed">
                <div class="embed-author">docs.openai.com</div>
                <div class="embed-title">GPT-6</div>
                <a class="embed-link" href="#">https://openai.com/docs/models/gpt-6/</a>
                <footer>NEW PAGE · sitemap · 5108ms · Today at 6:20 PM</footer>
              </div>
              <div class="embed stacked">
                <div class="embed-author">docs.openai.com</div>
                <div class="embed-title">GPT-6 mini</div>
                <a class="embed-link" href="#">https://openai.com/docs/models/gpt-6-mini/</a>
                <footer>NEW PAGE · sitemap · 5108ms · Today at 6:20 PM</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>04</span>
          <div>
            <h2>page changed</h2>
            <p>Reserved for future content monitoring.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:24 PM</time></div>
              <div class="embed changed">
                <div class="embed-author">status.claude.com</div>
                <div class="embed-title">Claude service availability</div>
                <a class="embed-link" href="#">https://status.claude.com/</a>
                <footer>PAGE CHANGED · content · 2174ms · Today at 6:21 PM</footer>
              </div>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
