<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="dark">
    <title>Message preview — PagePulse</title>
    <link rel="stylesheet" href="/preview.css">
  </head>
  <body>
    <header>
      <a href="/">← dashboard</a>
      <span>discord / message preview</span>
    </header>

    <main>
      <div class="intro">
        <div>
          <span class="label">PROPOSED EMBEDS</span>
          <h1>notification states</h1>
        </div>
        <p>Static previews. Nothing here sends to Discord.</p>
      </div>

      <section>
        <div class="section-label">
          <span>01</span>
          <div>
            <h2>single page</h2>
            <p>One URL found in a scan.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:20 PM</time></div>
              <div class="embed">
                <div class="event-meta">
                  <span>NEW PAGE</span>
                  <span>SITEMAP</span>
                  <span>SCAN · 3821ms</span>
                </div>
                <div class="embed-title">New policy ideas for the Intelligence Age</div>
                <a class="embed-link" href="#">https://openai.com/index/new-policy-ideas-for-the-intelligence-age/</a>
                <footer><span class="mini-logo">W</span> openai.com · just now</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>02</span>
          <div>
            <h2>batch</h2>
            <p>Several URLs from one domain.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:21 PM</time></div>
              <div class="embed">
                <div class="event-meta">
                  <span>NEW PAGES · 3</span>
                  <span>SITEMAP</span>
                  <span>SCAN · 4196ms</span>
                </div>
                <div class="embed-title">3 New OpenAI Pages Detected</div>
                <div class="url-list">
                  <a href="#"><b>01</b><span><strong>Introducing GPT-6</strong><code>https://openai.com/index/introducing-gpt-6/</code></span></a>
                  <a href="#"><b>02</b><span><strong>GPT-6 System Card</strong><code>https://openai.com/index/gpt-6-system-card/</code></span></a>
                  <a href="#"><b>03</b><span><strong>GPT-6 Model Documentation</strong><code>https://openai.com/docs/models/gpt-6/</code></span></a>
                </div>
                <footer><span class="mini-logo">W</span> openai.com · just now</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>03</span>
          <div>
            <h2>large batch</h2>
            <p>The list is capped instead of flooding the channel.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:22 PM</time></div>
              <div class="embed">
                <div class="event-meta">
                  <span>NEW PAGES · 24</span>
                  <span>SITEMAP</span>
                  <span>SCAN · 5108ms</span>
                </div>
                <div class="embed-title">24 New OpenAI Docs Pages Detected</div>
                <div class="url-list compact">
                  <a href="#"><b>01</b><span><strong>GPT-6</strong><code>https://openai.com/docs/models/gpt-6/</code></span></a>
                  <a href="#"><b>02</b><span><strong>GPT-6 mini</strong><code>https://openai.com/docs/models/gpt-6-mini/</code></span></a>
                  <a href="#"><b>03</b><span><strong>Reasoning guide</strong><code>https://openai.com/docs/guides/reasoning/</code></span></a>
                  <a href="#"><b>04</b><span><strong>Using tools</strong><code>https://openai.com/docs/guides/tools/</code></span></a>
                  <a href="#"><b>05</b><span><strong>API changelog — August 17</strong><code>https://openai.com/docs/changelog/2026-08-17/</code></span></a>
                </div>
                <div class="overflow">+19 more URLs</div>
                <footer><span class="mini-logo">W</span> docs.openai.com · just now</footer>
              </div>
            </div>
          </article>
        </div>
      </section>

      <section>
        <div class="section-label">
          <span>04</span>
          <div>
            <h2>page changed</h2>
            <p>Reserved for future content monitoring.</p>
          </div>
        </div>
        <div class="discord">
          <article class="message">
            <div class="avatar">W</div>
            <div class="message-body">
              <div class="author">the watcher <span>APP</span> <time>Today at 5:24 PM</time></div>
              <div class="embed changed">
                <div class="event-meta">
                  <span>PAGE CHANGED</span>
                  <span>CONTENT</span>
                  <span>SCAN · 2174ms</span>
                </div>
                <div class="embed-title">Claude service availability</div>
                <a class="embed-link" href="#">https://status.claude.com/</a>
                <footer><span class="mini-logo">W</span> status.claude.com · just now</footer>
              </div>
            </div>
          </article>
        </div>
      </section>
    </main>
  </body>
</html>
