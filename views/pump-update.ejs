<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pump app update <%= update.update_id.slice(0, 8) %> · PagePulse</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">page<span>pulse</span></a>
      <div class="runtime">pump.fun app update</div>
    </header>

    <main class="shell pump-detail">
      <section class="command">
        <div>
          <span class="kicker">PUMP.FUN · ANDROID · OTA</span>
          <h1>runtime <%= update.runtime_version %></h1>
        </div>
        <a
          class="detail-source"
          href="https://play.google.com/store/apps/details?id=com.batonresearch.pump"
          target="_blank"
          rel="noopener noreferrer"
        >play store ↗</a>
      </section>

      <section class="summary github-summary">
        <span><b><%= update.change_count %></b> changes</span>
        <span><b><%= update.update_id.slice(0, 12) %></b> update</span>
        <span><b><%= update.previous_update_id ? update.previous_update_id.slice(0, 12) : "—" %></b> previous</span>
        <span><b><%= update.published_at || "—" %></b> published</span>
      </section>

      <section class="pump-change-report">
        <% if (!groups.some((group) => group.count)) { %>
          <div class="empty">bundle changed · no readable signals changed</div>
        <% } %>
        <% groups.filter((group) => group.count).forEach((group, index) => { %>
          <details class="block pump-change-group" <%= index === 0 ? "open" : "" %>>
            <summary>
              <span><%= group.label %></span>
              <span class="pump-group-counts">
                <b class="added">+<%= group.added.length %></b>
                <b class="removed">-<%= group.removed.length %></b>
                <b><%= group.count %> total</b>
              </span>
            </summary>

            <% ["added", "removed"].forEach((type) => { %>
              <% if (group[type].length) { %>
                <section class="pump-change-section">
                  <header>
                    <span class="change-type <%= type %>"><%= type %></span>
                    <span><%= group[type].length %> changes</span>
                  </header>
                  <div class="pump-change-values" tabindex="0">
                    <% group[type].forEach((item) => { %>
                      <article class="pump-change<%= item.previewUrl ? " has-preview" : "" %>">
                        <span aria-hidden="true"><%= type === "added" ? "+" : "−" %></span>
                        <% if (item.previewUrl) { %>
                          <div class="pump-asset">
                            <img src="<%= item.previewUrl %>" alt="<%= item.label %>" loading="lazy" />
                            <div>
                              <code><%= item.label %></code>
                              <% if (item.label !== item.key) { %><small><%= item.key %></small><% } %>
                            </div>
                          </div>
                        <% } else { %>
                          <code><%= item.label %></code>
                        <% } %>
                      </article>
                    <% }) %>
                  </div>
                </section>
              <% } %>
            <% }) %>
          </details>
        <% }) %>
      </section>
    </main>
  </body>
</html>
